# Dadi works with no keys (scripted lines). Add any free provider below and
# Dadi's lines are LLM-written; providers are tried in DADI_LLM_ORDER and
# fall through automatically on errors / rate limits.
# Check your setup with:  uv run python -m dadi.llm

# Groq: free, fastest (console.groq.com → API Keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini: free tier (aistudio.google.com → Get API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# OpenRouter: free ":free" models (openrouter.ai → Keys)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama: local and offline, no key (ollama pull qwen2.5:3b && ollama serve)
# OLLAMA_MODEL=qwen2.5:3b

# Any other OpenAI-compatible endpoint
DADI_LLM_BASE_URL=
DADI_LLM_API_KEY=
DADI_LLM_MODEL=

# DADI_LLM_ORDER=groq,gemini,openrouter,ollama,custom
# DADI_LLM_TIMEOUT=6
